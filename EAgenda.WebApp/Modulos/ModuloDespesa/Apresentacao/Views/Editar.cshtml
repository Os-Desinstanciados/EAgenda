@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edicao de Despesa";
}

@model EditarDespesaViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Editar" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden">

    <div class="mb-3">
        <label asp-for="Descricao" class="form-label fw-semibold text-primary text-uppercase small">Descrição</label>
        <input asp-for="Descricao" type="text" class="form-control">
        <span asp-validation-for="Descricao" class="text-danger small fw-semibold"></span>
    </div>    

    <div class="mb-3">
        <label asp-for="DataOcorrencia" class="form-label fw-semibold text-primary text-uppercase small">Data de Ocorrência</label>
        <input asp-for="DataOcorrencia" type="text" class="form-control">
        <span asp-validation-for="DataOcorrencia" class="text-danger small fw-semibold"></span>
    </div>
     
    <div class="mb-3">
        <label asp-for="Valor" class="form-label fw-semibold text-primary text-uppercase small">Data de Ocorrência</label>
        <input asp-for="DataOcorrencia" type="number" class="form-control">
        <span asp-validation-for="DataOcorrencia" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FormaPagamento" class="form-label">Forma de Pagamento</label>
        <select asp-for="FormaPagamento" 
                asp-items="Html.GetEnumSelectList<FormaPagamentoEnum>()" 
                class="form-select">            
        </select>
        <span asp-validation-for="FormaPagamento" class="text-danger"></span>
    </div> 

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>
