@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Despesa";
}

@model CadastrarDespesaViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Cadastrar" method="post">
     
    <div class="mb-3">
        <label asp-for="Descricao" class="form-label fw-semibold text-primary text-uppercase small">Descrição</label>
        <input asp-for="Descricao" type="text" class="form-control">
        <span asp-validation-for="Descricao" class="text-danger small fw-semibold"></span>
    </div>
     
    <div class="mb-3">
        <label asp-for="DataOcorrencia" class="form-label fw-semibold text-primary text-uppercase small">Data de Ocorrência</label>
        <input asp-for="DataOcorrencia" type="text" class="form-control">
        <span asp-validation-for="DataOcorrencia" class="text-danger small fw-semibold"></span>
    </div>
     
    <div class="mb-3">
        <label asp-for="Valor" class="form-label fw-semibold text-primary text-uppercase small">Valor</label>
        <input asp-for="Valor" type="number" class="form-control">
        <span asp-validation-for="Valor" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FormaPagamento" class="form-label">Forma de Pagamento</label>
        <select asp-for="FormaPagamento" 
                asp-items="Html.GetEnumSelectList<FormaPagamentoEnum>()" 
                class="form-select">            
        </select>
        <span asp-validation-for="FormaPagamento" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label asp-for="CategoriaId" class="form-label fw-semibold text-primary text-uppercase small">Categoria</label>
        <select asp-for="CategoriaId" class="form-select">
            <option value="">Selecione uma categoria</option>
            @foreach (OpcaoCategoriaViewModel categoria in Model.Categorias)
            {
                <option value="@categoria.Id">@categoria.Titulo</option>
            }
        </select>
        <span asp-validation-for="CategoriaId" class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        @if (Model.Categorias.Count == 0)
        {
            <button class="btn btn-primary rounded-pill px-4" type="submit" disabled>Confirmar</button>
        }
        else
        {
            <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
        }
    </div>
</form>